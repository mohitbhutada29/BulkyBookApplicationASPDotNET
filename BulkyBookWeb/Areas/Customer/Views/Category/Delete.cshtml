@* (78) Creating the Delete view. We will copy everything from the Delete.cshtml and make relevant changes *@

@using BulkyBook.Models
@model Category


<div class="container-fluid py-3">
    <a href="#" class="text-decoration-none text-secondary small fw-medium d-inline-flex align-items-center gap-1 mb-3">
        <i class="bi bi-arrow-left"></i> Back to categories
    </a>
    <div class="card border shadow-sm overflow-hidden">
        <div class="card-header text-white py-3 px-4" style="background: linear-gradient(to right, #065f46, #282828, #191414);">
            <h5 class="mb-0 fw-bold"><i class="bi bi-plus-lg me-2"></i>Delete Category</h5>
            <p class="mb-0 small" style="color: #1DB954;">Delete category for your products</p>
        </div>
        <div class="card-body p-4">
            @* (79) Here now we have a new form that would automatically call the post delete method, ut if we want to explicitly 

            add we can define the asp-action="Delete" in (73) *@
            <form method="post" asp-action="Delete">
                @*  (80) Sometimes the id is not been sent. for that we add a new input element which is hidden.
                    If something is not working make sure you check the object retrieved in the Post method and make sure everything is coming properly. *@
                <input asp-for="Id" hidden />
                @* (81) In Delete we do not have any validations, so all the input fields will be read-only and remove the validations.
                    With that all the CRUD endpoints are in place and we can now test the application.
                *@
                <div class="text-danger mb-3"></div>
                <div class="mb-3">
                    <label asp-for="Name" class="form-label fw-semibold small">Category Name</label>
                    <input type="text" readonly name="Name" asp-for="Name" class="form-control" placeholder="Enter category name" />
                    <span asp-validation-for="Name" class="text-danger small"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="DisplayOrder" class="form-label fw-semibold small">Display Order</label>
                    <input type="number" readonly name="DisplayOrder" asp-for="DisplayOrder" class="form-control" placeholder="Enter display order" />
                    <span asp-validation-for="DisplayOrder" class="text-danger small"></span>
                </div>
                <div class="d-flex gap-2 mt-4">
                    <button type="submit" class="btn btn-danger fw-semibold">Delete Category</button>
                    <a asp-controller="Category" asp-action="Index" class="btn btn-light fw-medium">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}
